# =============================================================================
# HueWhimsy production environment template
# Copy to .env.production on the VPS, then fill secrets via:
#   openssl rand -hex 32      (for JWT_SECRET / COOKIE_SECRET / REVALIDATE_SECRET)
#   openssl rand -base64 24   (for POSTGRES_PASSWORD)
# Never commit the real .env file.
# =============================================================================

# Public domain (use temp Hostinger hostname until real domain is wired)
PUBLIC_HOST=srv1667251.hstgr.cloud
PUBLIC_SCHEME=https

# --- PostgreSQL ---
POSTGRES_USER=huewhimsy
POSTGRES_PASSWORD=CHANGE_ME_strong_base64_password
POSTGRES_DB=huewhimsy

# --- Medusa backend ---
JWT_SECRET=CHANGE_ME_hex32
COOKIE_SECRET=CHANGE_ME_hex32
MEDUSA_BACKEND_URL=https://srv1667251.hstgr.cloud
STORE_CORS=https://srv1667251.hstgr.cloud
ADMIN_CORS=https://srv1667251.hstgr.cloud
AUTH_CORS=https://srv1667251.hstgr.cloud

# --- Next.js storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://srv1667251.hstgr.cloud
NEXT_PUBLIC_BASE_URL=https://srv1667251.hstgr.cloud
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME_hex32

# --- Admin/Ops ---
ADMIN_EMAIL=hasib107040@gmail.com
LETSENCRYPT_EMAIL=hasib107040@gmail.com

# =============================================================================
# Phase 2 — Payment / Email / Storage
# Leave as CHANGE_ME to disable each provider (Medusa boots without crashing).
# =============================================================================

# --- Stripe (payment) ---
# Get keys from https://dashboard.stripe.com/apikeys
# Webhook secret from https://dashboard.stripe.com/webhooks (endpoint: https://huewhimsy.com/hooks/stripe)
STRIPE_SECRET_KEY=CHANGE_ME_sk_test_...
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_...
STRIPE_DESCRIPTION=HueWhimsy order

# --- Resend (transactional email) ---
# Sign up at https://resend.com (3000 free emails/mo). Add huewhimsy.com domain
# and DKIM/SPF DNS records before flipping to live keys.
RESEND_API_KEY=CHANGE_ME_re_...
RESEND_FROM_EMAIL=HueWhimsy <noreply@huewhimsy.com>
RESEND_REPLY_TO=hello@huewhimsy.com

# Where contact-form-admin-alert mails are sent
CONTACT_ADMIN_EMAIL=hasib107040@gmail.com

# --- Cloudflare R2 (S3-compatible file storage) ---
# Create a bucket at https://dash.cloudflare.com/?to=/:account/r2/buckets
# Generate an R2 API token with Object Read+Write to that bucket.
# The endpoint is per-account: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# file_url is the public bucket URL (custom domain or pub-*.r2.dev).
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=huewhimsy-media
S3_REGION=auto
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_FILE_URL=https://files.huewhimsy.com
