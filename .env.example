# =============================================================================
# HueWhimsy production environment template
# Copy to .env.production on the VPS, then fill secrets via:
#   openssl rand -hex 32      (for JWT_SECRET / COOKIE_SECRET / REVALIDATE_SECRET)
#   openssl rand -base64 24   (for POSTGRES_PASSWORD)
# Never commit the real .env file.
# =============================================================================

# Public domain (use temp Hostinger hostname until real domain is wired)
PUBLIC_HOST=srv1667251.hstgr.cloud
PUBLIC_SCHEME=https

# --- PostgreSQL ---
POSTGRES_USER=huewhimsy
POSTGRES_PASSWORD=CHANGE_ME_strong_base64_password
POSTGRES_DB=huewhimsy

# --- Medusa backend ---
JWT_SECRET=CHANGE_ME_hex32
COOKIE_SECRET=CHANGE_ME_hex32
MEDUSA_BACKEND_URL=https://srv1667251.hstgr.cloud
STORE_CORS=https://srv1667251.hstgr.cloud
ADMIN_CORS=https://srv1667251.hstgr.cloud
AUTH_CORS=https://srv1667251.hstgr.cloud

# --- Next.js storefront ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://srv1667251.hstgr.cloud
NEXT_PUBLIC_BASE_URL=https://srv1667251.hstgr.cloud
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME_hex32

# --- Admin/Ops ---
ADMIN_EMAIL=hasib107040@gmail.com
LETSENCRYPT_EMAIL=hasib107040@gmail.com
